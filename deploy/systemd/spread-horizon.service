[Unit]
Description=Spread Horizon (queued jobs, e.g. report stats rebuilds)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/spread
ExecStart=/usr/bin/php artisan horizon
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
